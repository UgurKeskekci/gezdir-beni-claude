# Copy to .env.local and fill in. Every variable here must also exist in src/config/env.ts.
# NEXT_PUBLIC_* values are visible in the browser — never put secrets in them.

# Public URL of the site (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Booking API (the service in api/). Start it with `npm run dev` inside api/.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
