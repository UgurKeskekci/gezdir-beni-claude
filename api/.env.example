# Copy to .env and fill in. .env is git-ignored; .env.example is the documented template.

# SQLite file, relative to the api/ folder.
DATABASE_URL="file:./dev.db"

# Port this API listens on.
PORT=4000

# The frontend origin allowed to send credentialed requests (CORS).
WEB_ORIGIN="http://localhost:3000"

# Admin panel password. At least 8 characters.
ADMIN_PASSWORD="change-me-please"

# Signs the admin session cookie. At least 32 characters.
# Generate one with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Hours an admin session stays valid.
SESSION_TTL_HOURS=12
